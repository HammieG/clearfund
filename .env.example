# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/clearfund?schema=public"

# Auth.js / NextAuth signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-unique-long-random-secret"

# Compatibility fallback. Set this to the same value as AUTH_SECRET only when
# integrating with software that still reads the legacy NextAuth variable name.
NEXTAUTH_SECRET="replace-with-the-same-value-as-auth-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth credentials. Add http://localhost:3000/api/auth/callback/google
# as an authorized redirect URI in Google Cloud for local development.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Set to true only after both Google variables are configured.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# Local-preview only: enables temporary in-memory registrations when PostgreSQL
# is unavailable. Never enable this in production.
CLEARFUND_DEMO_MODE="false"
